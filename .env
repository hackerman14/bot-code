# Environment Config

# store your secrets and config variables in here
# reference these in your code with process.env.SECRET

# note: .env is a shell file so there can't be spaces around =

# CheweyZ Discord Bot Anylytics to track several bot statistics
CHEWEY=CHEWEY_API_KEY

# Top.gg API Key to post bot stats
TOPGG=TOPGG_API_KEY

# Used in gif.js, put your Giphy and Tenor API keys here
GIPHY=GIPHY_API_KEY
TENOR=TENOR_API_KEY

# Used in define.js, put your Marriam-Webster Dictionary API key here
MW=MERRIAM-WEBSTER_API_KEY

# Used in meme.js, put your Reddit API credentials here
REDDIT_CLIENT_ID=REDDIT_APP_ID
REDDIT_CLIENT_SECRET=REDDIT_APP_SECRET

# Used in feedback.js, put your Resend API key and email addresses here
RESEND=RESEND_API_KEY
EMAIL_SENDER=YOUR_SENDER_EMAIL_ADDRESS
EMAIL_RECEIVER=YOUR_RECEIVER_EMAIL_ADDRESS

# Used in photo.js, put your Unsplash API access key here
UNSPLASH=UNSPLASH_ACCESS_KEY

# Set this to your bot's token
DISCORD=DISCORD_BOT_TOKEN

# Set this to your bot's client ID, aka application ID
CLIENTID=DISCORD_APPLICATION_ID

# Set a default server ID for testing guild-only commands
GUILDID=DISCORD_TEST_GUILD_ID

# Set this to your Discord user ID
OWNERID=DISCORD_BOT_OWNER_ID

# The name of bot owner
BOTOWNER=YOUR_NAME